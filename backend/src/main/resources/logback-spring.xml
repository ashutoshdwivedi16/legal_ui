<?xml version="1.0" encoding="UTF-8"?>
<configuration>
    <appender name="console" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>%d{HH:mm:ss.SSS} [%thread] %X{x-session-id} %X{x-correlation-id} %X{x-request-id} %-5level %logger{} %message%n</pattern>
        </encoder>
    </appender>
    <appender name="stdout" class="ch.qos.logback.core.ConsoleAppender">
        <encoder class="net.logstash.logback.encoder.LogstashEncoder">
            <providers>
                <timestamp>
                    <timeZone>EST</timeZone>
                </timestamp>
                <pattern>
                    <pattern>
                        {
                        "service": "admin-service",
                        "level": "%level",
                        "thread": "%thread",
                        "correlation": {
                        "correlationId": "%X{x-correlation-id}",
                        "sessionId": "%X{x-session-id}",
                        "requestId": "%X{x-request-id}"
                        },
                        "class": "%c",
                        "method": "%M[%line]",
                        "message": "%message"
                        }
                    </pattern>
                </pattern>
                <stackTrace>
                    <throwableConverter class="net.logstash.logback.stacktrace.ShortenedThrowableConverter">
                        <maxDepthPerThrowable>30</maxDepthPerThrowable>
                        <maxLength>2048</maxLength>
                        <shortenedClassNameLength>20</shortenedClassNameLength>
                        <rootCauseFirst>true</rootCauseFirst>
                    </throwableConverter>
                </stackTrace>
            </providers>
        </encoder>
    </appender>
    <springProfile name="LOCAL,DEV,QA,DEV_NUM,QA_NUM">
        <root level="info">
            <appender-ref ref="console"/>
        </root>
        <logger name="com.lg.microservice.admin" level="debug" additivity="false">
            <appender-ref ref="console"/>
        </logger>
    </springProfile>
    <springProfile name="STG,PRD">
        <root level="fatal">
            <appender-ref ref="stdout"/>
        </root>
        <logger name="com.lg.microservice.admin" level="info" additivity="false">
            <appender-ref ref="stdout"/>
        </logger>
    </springProfile>
</configuration>