# Development Dockerfile for Spring Boot application
# Optimized for local development with mounted volumes
# Note: This is for local development only. Production builds use a separate Dockerfile.
FROM eclipse-temurin:21-jdk-alpine

# Install necessary tools
RUN apk add --no-cache bash curl

# Set working directory
WORKDIR /app

# Copy Gradle wrapper files (these won't be overridden by volume mount)
COPY gradle ./gradle
COPY gradlew ./
COPY build.gradle settings.gradle ./

# Make gradlew executable
RUN chmod +x ./gradlew

# Pre-download dependencies to speed up first run
# This layer will be cached and dependencies will be in /root/.gradle
RUN ./gradlew dependencies --no-daemon || true

# Expose the application port
EXPOSE 8080

# Health check endpoint (using context path /us/common/admin)
HEALTHCHECK --interval=30s --timeout=3s --start-period=60s --retries=3 \
  CMD curl -f http://localhost:8080/us/common/admin/actuator/health || exit 1

# Run the application using bootRun for development
# Source code will be mounted from docker-compose volumes
# This enables hot-reload with Spring Boot DevTools
CMD ./gradlew bootRun --no-daemon -Dspring.profiles.active=${SPRING_PROFILES_ACTIVE:-LOCAL}

