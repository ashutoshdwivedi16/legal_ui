# =============================================================================
# Product Comparison API - Environment Configuration
# =============================================================================
# Copy to .env and fill in values for local development.
# Production: set via ECS/K8s environment.

# -----------------------------------------------------------------------------
# Application
# -----------------------------------------------------------------------------
APP_ENV=development
APP_DEBUG=true
APP_LOG_LEVEL=INFO

# -----------------------------------------------------------------------------
# Database (PDS - MySQL Aurora)
# -----------------------------------------------------------------------------
PDS_DB_HOST=localhost
PDS_DB_PORT=3306
PDS_DB_USER=root
PDS_DB_PASSWORD=password
PDS_DB_NAME=product_data_store

# Connection pool
PDS_POOL_SIZE=5
PDS_MAX_OVERFLOW=10

# -----------------------------------------------------------------------------
# Database (AI - Postgres)
# -----------------------------------------------------------------------------
AI_DB_HOST=localhost
AI_DB_PORT=5432
AI_DB_USER=postgres
AI_DB_PASSWORD=postgres
AI_DB_NAME=ai_db

# -----------------------------------------------------------------------------
# Compliance Validator
# -----------------------------------------------------------------------------
# Directory containing compliance project files (JSON/CSV inputs)
COMPLIANCE_PROJECTS_DIR=common/agents/compliance_validator/projects

# Optional: JSON config for scheduled batch runs
# COMPLIANCE_PROJECT_CONFIGS={"1":[{"type":"database","table":"products","column":"ai_description","content_type":"product_description"}]}

# -----------------------------------------------------------------------------
# Redis (ElastiCache)
# -----------------------------------------------------------------------------
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
# REDIS_PASSWORD=           # Uncomment if auth required

# Cache TTL (7 days = 604800 seconds)
CACHE_TTL_SECONDS=604800

# -----------------------------------------------------------------------------
# LLM (LiteLLM Gateway)
# -----------------------------------------------------------------------------
# Model identifier for LiteLLM gateway (examples: openai/gpt-4o-mini, openai/us.anthropic.claude-sonnet-4-20250514-v1:0)
LLM_MODEL=openai/bedrock/global.anthropic.claude-opus-4-5-20251101-v1:0

# LiteLLM gateway credentials
LITELLM_BASE_URL=http://llm-gateway.lgcomus-dev.lge.com/v1
LITELLM_API_KEY=your-litellm-api-key

# LLM parameters
LLM_TIMEOUT_SECONDS=10
LLM_MAX_TOKENS=2048
LLM_TEMPERATURE=0.3

# -----------------------------------------------------------------------------
# Rate Limiting
# -----------------------------------------------------------------------------
RATE_LIMIT_PER_MINUTE=100

# -----------------------------------------------------------------------------
# SCM Dashboard DB (MySQL)
# -----------------------------------------------------------------------------
SCM_DB_HOST=localhost
SCM_DB_PORT=3306
SCM_DB_USER=scm_user
SCM_DB_PASSWORD=scm_password
SCM_DB_NAME=ai_data_store

# -----------------------------------------------------------------------------
# SSH Tunnel – AIC Bastion (local dev only; omit in deployed envs)
# -----------------------------------------------------------------------------
# SEC_AIC_BASTION_HOST=                  # SSH tunnel target host
# SEC_AIC_BASTION_PORT=22
# SEC_AIC_BASTION_USERNAME=              # SSH username
# SEC_AIC_BASTION_PRIVATE_KEY_PATH=/app/keys/id_rsa

# -----------------------------------------------------------------------------
# AIC DB (via SSH tunnel locally, direct in deployed envs)
# -----------------------------------------------------------------------------
# SEC_AIC_DB_HOST=127.0.0.1
# SEC_AIC_DB_PORT=3306
# SEC_AIC_DB_USER=
# SEC_AIC_DB_PASSWORD=
# SEC_AIC_DB_NAME=
